	partition 'public clientes' = m
		mode: import
		source =
				// Consulta: public clientes
				let
				  Origen = PostgreSQL.Database("ep-twilight-water-bewet8tx-pooler.c-9.us-east-2.aws.neon.tech", "internet"),
				  Datos = Origen{[Schema = "public", Item = "clientes"]}[Data],
				  LimpiarTexto = (v, vacio) =>
				    let t = if v = null then "" else Text.Trim(Text.From(v))
				    in if t = "" or Text.Lower(t) = "n/a" then vacio else t,
				  Nombre = Table.TransformColumns(Datos, {{"nombre", each LimpiarTexto(_, "Sin nombre"), type text}}),
				  Segmento = Table.TransformColumns(Nombre, {{"segmento", each let s = LimpiarTexto(_, "Sin segmento") in if s = "Frequente" then "Frecuente" else s, type text}})
				in
				  Segmento

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

