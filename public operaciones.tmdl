		annotation SummarizationSetBy = Automatic

	column 'Año Mes' =
			
			VAR f = 'public operaciones'[fecha]
			RETURN
			IF(ISBLANK(f) || f < DATE(2020,1,1) || f > TODAY(), BLANK(), FORMAT(f, "yyyy-mm"))
		lineageTag: f6159be9-2ee5-404e-a0e1-ec9e11abe7c0
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition 'public operaciones' = m
		mode: import
		source =
				// Consulta: public operaciones
				let
				  Origen = PostgreSQL.Database("ep-twilight-water-bewet8tx-pooler.c-9.us-east-2.aws.neon.tech", "internet"),
				  Datos = Table.Buffer(Origen{[Schema = "public", Item = "operaciones"]}[Data]),
				  LimpiarEstado = (v) =>
				    let t = Text.Lower(Text.Trim(if v = null then "" else Text.From(v)))
				    in if t = "" or t = "???" or t = "estado desconocido" or t = "vacio" or t = "vacío" or t = "(en blanco)" then "sin estado" else t,
				  LimpiarCanal = (v) =>
				    let t = Text.Lower(Text.Trim(if v = null then "" else Text.From(v)))
				    in if t = "" or t = "??" or t = "vacio" or t = "vacío" or t = "n/a" or t = "sin estado" then "sin canal"
				       else if t = "tienda" then "presencial"
				       else if t = "web" or t = "app" or t = "app??" or t = "digtal" then "digital"
				       else t,
				  Resultado = Table.TransformColumns(Datos, {{"estado", LimpiarEstado, type text}, {"canal", LimpiarCanal, type text}})
				in
				  Resultado

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

